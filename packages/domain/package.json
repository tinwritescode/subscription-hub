{
  "name": "@subhub/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware src/",
    "test": "vitest run"
  },
  "dependencies": {
    "ts-rust": "0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.2"
  }
}
